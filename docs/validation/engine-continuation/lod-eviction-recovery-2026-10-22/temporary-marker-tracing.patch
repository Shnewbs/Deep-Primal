+
+  private static jdk.jfr.Recording traceRecording;
+  private static boolean tracing;
+  private static synchronized void traceStart() {
+    if (tracing) return;
+    tracing = true;
+    try {
+      Files.createDirectories(MARKER.getParent());
+      var watch = MARKER.getFileSystem().newWatchService();
+      MARKER.getParent().register(watch,
+          java.nio.file.StandardWatchEventKinds.ENTRY_CREATE,
+          java.nio.file.StandardWatchEventKinds.ENTRY_DELETE,
+          java.nio.file.StandardWatchEventKinds.ENTRY_MODIFY);
+      traceRecording = new jdk.jfr.Recording();
+      traceRecording.enable("jdk.FileWrite").withThreshold(java.time.Duration.ZERO).withStackTrace();
+      traceRecording.setMaxSize(16 * 1024 * 1024);
+      traceRecording.setDuration(java.time.Duration.ofSeconds(180));
+      traceRecording.setDestination(Path.of(System.getProperty("deepprimal.validationCapture"), "marker-writes.jfr"));
+      traceRecording.setDumpOnExit(true);
+      traceRecording.start();
+      Thread watcher = new Thread(() -> {
+        long deadline = System.nanoTime() + java.util.concurrent.TimeUnit.SECONDS.toNanos(180);
+        int events = 0;
+        try (watch) {
+          while (events < 256 && System.nanoTime() < deadline) {
+            var key = watch.poll(250, java.util.concurrent.TimeUnit.MILLISECONDS);
+            if (key == null) continue;
+            for (var event : key.pollEvents()) {
+              if (MARKER.getFileName().equals(event.context())) {
+                trace("watch-" + event.kind() + " count=" + event.count());
+                events++;
+              }
+            }
+            if (!key.reset()) break;
+          }
+        } catch (Exception failure) { trace("watch-failed=" + failure); }
+      }, "Validation marker events");
+      watcher.setDaemon(true); watcher.start();
+      trace("watch-start");
+    } catch (Exception failure) { System.out.println("MARKER_ORIGIN_SETUP_FAILED " + failure); }
+  }
+  private static void trace(String event) {
+    try {
+      String attributes = "absent";
+      if (Files.exists(MARKER)) {
+        var a = Files.readAttributes(MARKER, java.nio.file.attribute.BasicFileAttributes.class);
+        attributes = "fileKey=" + a.fileKey() + " size=" + a.size() + " modified=" + a.lastModifiedTime()
+            + " content=" + Files.readString(MARKER).replace("\n", "<LF>");
+      }
+      String record = "MARKER_ORIGIN event=" + event + " nano=" + System.nanoTime()
+          + " pid=" + ProcessHandle.current().pid() + " thread=" + Thread.currentThread().getName()
+          + " loader=" + Startup.class.getClassLoader() + " origin=" + Startup.class.getProtectionDomain().getCodeSource()
+          + " path=" + MARKER.toAbsolutePath().normalize() + " " + attributes
+          + " stack=" + StackWalker.getInstance().walk(frames -> frames.limit(8).toList()) + "\n";
+      System.out.print(record);
+      Files.writeString(Path.of(System.getProperty("deepprimal.validationCapture"), "marker-events.txt"), record,
+          java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND);
+    } catch (Exception error) { System.out.println("MARKER_ORIGIN_CAPTURE_FAILED " + event + " " + error); }
+  }
