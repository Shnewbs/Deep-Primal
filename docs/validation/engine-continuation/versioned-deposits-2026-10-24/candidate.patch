+        case 2 -> true;
+        case 3 -> h==Geology.Rock.GRANITE||h==Geology.Rock.DIORITE;
+        case 4 -> h==Geology.Rock.BASALT||h==Geology.Rock.GRANITE;
+        case 5 -> h==Geology.Rock.CALCITE;
